<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this framework theme only styles the window
         pre-composition (minSdk 29 → attributes are safe without -v23 qualifiers). -->
    <style name="Theme.CarryOn" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
